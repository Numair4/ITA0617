# EXPERIMENT 10 – EXPECTATION MAXIMIZATION

from sklearn.mixture import GaussianMixture
import numpy as np

X = np.array([
    [1],
    [2],
    [3],
    [10],
    [11],
    [12]
])

model = GaussianMixture(
    n_components=2,
    random_state=42
)

model.fit(X)

print("Cluster Labels:")
print(model.predict(X))
